<Window x:Class="ServoAnimator.SetFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Folders"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

    <!-- Prompted automatically on first run and available from Config > Set Paths.
         Only Configuration is selected; Projects is always its Projects child. -->
    <StackPanel Margin="14">
        <TextBlock x:Name="IntroText" Foreground="#C8CCD4" TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Choose the Configuration folder. The application will always use its Projects child folder for sequences, movies, source audio, and exported animation JSONs."/>

        <TextBlock Text="Configuration folder:" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
        <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="Browse…" Width="80"
                    Margin="6,0,0,0" Click="BrowseConfig_Click"/>
            <TextBox x:Name="ConfigBox"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
