<Window x:Class="ServoAnimator.RgbColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select RGB Color"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">
    <StackPanel Margin="14">
        <TextBlock Text="Color" Foreground="{DynamicResource HeaderText}"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <Grid x:Name="SvArea" Height="180" Cursor="Cross"
              MouseLeftButtonDown="SvArea_MouseLeftButtonDown"
              MouseMove="SvArea_MouseMove">
            <Border x:Name="SvHueBase" CornerRadius="3"/>
            <Border CornerRadius="3" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse x:Name="SvMarker" Width="12" Height="12"
                     Stroke="White" StrokeThickness="2" Fill="Transparent"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     IsHitTestVisible="False"/>
        </Grid>

        <TextBlock Text="Hue" Foreground="{DynamicResource PrimaryText}" Margin="0,10,0,3"/>
        <Grid x:Name="HueBar" Height="22" Cursor="Hand"
              MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
              MouseMove="HueBar_MouseMove">
            <Border CornerRadius="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0"/>
                        <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                        <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                        <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                        <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FFFF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="HueMarker" Width="4" Background="White"
                    BorderBrush="#FF202020" BorderThickness="1"
                    HorizontalAlignment="Left" IsHitTestVisible="False"/>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ColorPreview" Grid.Column="0" Height="32"
                    CornerRadius="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"/>
            <TextBlock x:Name="RgbText" Grid.Column="1" Margin="10,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"
                       FontFamily="Consolas"/>
        </Grid>

        <!-- Explicit 0-255 values returned to Build RGB Command. -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="54"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Red" Margin="0,0,5,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="RedValue" Grid.Column="1" IsReadOnly="True"
                     HorizontalContentAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Green" Margin="12,0,5,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="GreenValue" Grid.Column="3" IsReadOnly="True"
                     HorizontalContentAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Blue" Margin="12,0,5,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="BlueValue" Grid.Column="5" IsReadOnly="True"
                     HorizontalContentAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Apply RGB" Width="92" IsDefault="True" Click="ApplyRgb_Click"
                    ToolTip="Copy these Red, Green and Blue values to Build RGB Command"/>
            <Button Content="Cancel" Width="70" Margin="6,0,0,0"
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
