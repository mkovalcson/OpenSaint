<Window x:Class="ServoAnimator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServoAnimator"
        Title="Animation Editor &amp; Player"
        Width="1250" Height="880"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource AppBackground}">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo"
                        Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo"
                        Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>





    <!-- ==================================================================
         Layout (top to bottom):
           1. Toolbar        - file operations, clear, live drive, name
           2. Servo grid     - last state of every servo + live-drive sliders
           3. Waveform       - SkiaSharp timeline (fills remaining space)
           4. Scrollbar      - horizontal scroll for the waveform
           5. Transport      - play/pause, zoom, time readout
           6. Commands list  - all commands at the selected cursor position
         ================================================================== -->
    <DockPanel>
        <!-- ============ MOVIE TIMELINE ============ -->
        <Border DockPanel.Dock="Bottom" x:Name="MovieTimelinePanel"
                Background="{DynamicResource MoviePanelBackground}" BorderBrush="{DynamicResource MovieAccent}" BorderThickness="1"
                Margin="6,4,6,0" CornerRadius="{StaticResource PanelCornerRadius}" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                    <AdornerDecorator Grid.Row="0">
                        <local:MovieTimelineView x:Name="MovieTimeline" Margin="0,0,0,2" Focusable="True"/>
                    </AdornerDecorator>
                    <Border x:Name="MovieEmptyStatePanel" Grid.Row="0" Panel.ZIndex="5"
                            Background="{DynamicResource MoviePanelBackground}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="4" Margin="1,1,1,3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Build a movie timeline" Foreground="{DynamicResource PrimaryText}"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Load Movie…" Padding="10,4" Margin="0,0,5,0" Click="EmptyLoadMovie_Click"/>
                                <Button Content="Insert First Sequence…" Padding="10,4" Click="EmptyInsertFirstSequence_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollBar x:Name="MovieScroll" Grid.Row="1" Orientation="Horizontal" Height="14" Scroll="MovieScroll_Scroll"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                        <Button Content="−" Width="30" Height="30" Margin="5,0,2,0" ToolTip="Zoom movie timeline out" Click="MovieZoomOut_Click"/>
                        <Button Content="+" Width="30" Height="30" Margin="2,0" ToolTip="Zoom movie timeline in" Click="MovieZoomIn_Click"/>
                        <Button Content="Fit" Width="42" Height="30" Margin="2,0" ToolTip="Fit complete movie" Click="MovieZoomFit_Click"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                            Padding="13,0,0,0" Margin="0,2,14,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Height="{Binding ActualHeight, ElementName=PlayPauseBtn}">
                        <Button x:Name="MoviePreviousButton" Content="|◀" Width="36" Margin="0,0,4,0" Style="{StaticResource StudioTransportButton}"
                                ToolTip="Restart current sequence; if already at its start, move to previous sequence — Left Arrow"
                                Click="MoviePrevious_Click"/>
                        <Button x:Name="MoviePlayButton" Content="▶ Movie" Margin="0,0,4,0" Style="{StaticResource StudioPlayButton}"
                                ToolTip="Play/Pause movie sequence — Up Arrow" Click="MoviePlay_Click"/>
                        <Button x:Name="MovieNextButton" Content="▶|" Width="36" Style="{StaticResource StudioTransportButton}"
                                ToolTip="Play next sequence — Right Arrow" Click="MovieNext_Click"/>
                    </StackPanel>
                    </Border>
                    <Grid Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="MovieFileText"
                                   Text="(unsaved)* — 0 s" Foreground="{DynamicResource WarningText}"
                                   VerticalAlignment="Center" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" x:Name="MovieDescriptionText" Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"><Run x:Name="MovieDescriptionRun"/><Run Text="  "/><Hyperlink
                                x:Name="MovieDescriptionEditButton" FontSize="11" FontWeight="Bold" TextDecorations="{x:Null}"
                                Foreground="{DynamicResource PrimaryText}" ToolTip="Edit the movie description"
                                Click="MovieDescriptionEdit_Click">edit</Hyperlink></TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ SEQUENCE TRANSPORT ============ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SequencePanelBackground}"
                BorderBrush="{DynamicResource SequenceAccent}" BorderThickness="1" Padding="8,6"
                Margin="6,4,6,0" CornerRadius="{StaticResource PanelCornerRadius}">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <Button Content="−" Width="30" Height="30" Margin="5,0,2,0" ToolTip="Zoom out around the cursor" Click="ZoomOut_Click"/>
                    <Button Content="+" Width="30" Height="30" Margin="2,0" ToolTip="Zoom in around the cursor" Click="ZoomIn_Click"/>
                    <Button Content="Fit" Width="42" Height="30" Margin="2,0" ToolTip="Fit the whole sequence" Click="ZoomFit_Click"/>
                </StackPanel>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="13,0,0,0" Margin="0,2,14,2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="|◀" Style="{StaticResource StudioTransportButton}" Width="34" Margin="0,0,4,0" ToolTip="Move sequence cursor to beginning" Click="SequenceRestart_Click"/>
                        <Button x:Name="PlayPauseBtn" Content="▶ Sequence" Style="{StaticResource StudioPlayButton}" ToolTip="Play/pause sequence — Space (timeline or background focus)" Click="PlayPause_Click"/>
                        <Button Content="■" Style="{StaticResource StudioTransportButton}" Width="34" Margin="4,0,9,0" ToolTip="Stop sequence playback" Click="SequenceStop_Click"/>
                        <Border Background="{DynamicResource InputBackground}" CornerRadius="5" Padding="9,2">
                            <TextBlock x:Name="TimeText" Text="0.000 s" Foreground="{DynamicResource PrimaryText}" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center" Width="112" TextAlignment="Right"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="13,0,0,0" Margin="0,2,14,2">
                    <StackPanel Orientation="Horizontal" Height="30">
                        <TextBlock Text="VOLUME" Style="{StaticResource SectionCaption}" Margin="0,0,6,0"/>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                ToolTip="Audio playback volume" ValueChanged="PlaybackVolume_Changed"/>
                        <TextBlock x:Name="VolumeText" Text="100%" Foreground="{DynamicResource SecondaryText}" FontFamily="Consolas"
                                   Width="39" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <ComboBox x:Name="TimelineLayoutPicker" Width="132" Height="30" SelectedIndex="2"
                              ToolTip="Timeline layout" SelectionChanged="TimelineLayout_Changed">
                        <ComboBoxItem Content="Waveform top"/>
                        <ComboBoxItem Content="Spline top"/>
                        <ComboBoxItem Content="Combined"/>
                    </ComboBox>
                    <Button Content="?" Width="30" Height="30" Margin="6,0,0,0" ToolTip="Controls and hotkeys • wheel zoom • middle-drag pan • right-click actions" Click="HelpControls_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ============ 4. SCROLLBAR ============ -->
        <ScrollBar DockPanel.Dock="Bottom" x:Name="HScroll" Orientation="Horizontal"
                   Height="16" Scroll="HScroll_Scroll"/>

        <!-- Commands and docked URDF share the top pane above the resizable timelines. -->
        <Grid x:Name="EditorTimelineGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CommandsEditorColumn" Width="*" MinWidth="280"/>
                <ColumnDefinition x:Name="UrdfSplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="UrdfEditorColumn" Width="*" MinWidth="260"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="TopEditorRow" Height="250" MinHeight="80"/> <!-- grid + URDF -->
                <RowDefinition Height="Auto"/>                                      <!-- editor/audio splitter -->
                <RowDefinition x:Name="AudioTimelineRow" Height="*" MinHeight="120"/> <!-- audio -->
                <RowDefinition Height="Auto"/>                                      <!-- audio/spline splitter -->
                <RowDefinition x:Name="SplineTimelineRow" Height="0"/>              <!-- spline -->
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Hardware labels are always visible. Status circles stay hidden
                     until Live Drive has made its first USB connection attempt. -->
                <StackPanel x:Name="LiveControlsPanel" Orientation="Vertical" VerticalAlignment="Top"
                            Margin="6,8">
                    <TextBlock Text="HARDWARE" Style="{StaticResource SectionCaption}" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                    <ToggleButton x:Name="LiveDriveBtn" Height="30" MinHeight="0" Padding="8,0" Margin="0,0,0,8" Style="{StaticResource StudioLiveDriveToggle}"
                                  VerticalAlignment="Center" Checked="LiveDrive_Changed" Unchecked="LiveDrive_Changed">
                        <TextBlock><Run Text="● Drive HW: "/><Run x:Name="LiveDriveState" Text="Off" FontWeight="Bold"/></TextBlock>
                    </ToggleButton>
                    <Separator Margin="3,3,3,9"/>
                    <Button Content="Disable Servos" Height="28" Foreground="{DynamicResource WarningText}" MinHeight="0" Padding="8,0"
                            Margin="0,0,0,8" VerticalAlignment="Center"
                            ToolTip="Disable PWM on every Maestro servo channel (servos go limp)"
                            Click="DisableAll_Click"/>
                    <Button Content="Default Positions" Height="28" MinHeight="0" Padding="8,0"
                            Margin="0,0,0,8" VerticalAlignment="Center"
                            ToolTip="Move Maestro servos to configured Default PWM, set both Eye Pops to 0, and send ClearAll to the Arduino"
                            Click="ResetAll_Click"/>
                    <Separator Margin="3,3,3,9"/>
                    <Border CornerRadius="7" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            Background="{DynamicResource PanelBackground}" Padding="7,9">
                        <StackPanel HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse x:Name="MaestroStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Maestro" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse x:Name="ArduinoStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Arduino" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse x:Name="LeftTicStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Left Tic 249" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RightTicStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Right Tic 249" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>



                    <!-- ============ 1. MENU BAR ============
             Replaces the old button toolbar. Live Drive and the animation
             name are stateful controls so they live in a slim bar below. -->
        <Border x:Name="MainMenuPanel" Grid.Row="0" Grid.Column="0" Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

        <Menu Grid.Column="0" Background="{DynamicResource MenuBackground}" Padding="4,2">
            <Menu.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Menu.ItemsPanel>
            <Menu.Resources>
                <!-- Individual menu commands use whitespace only. Visible lines
                     come exclusively from explicit Separator elements, which
                     are reserved for true command groups. -->
                <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}">
                    <Setter Property="Foreground" Value="#20242A"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="1,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="TopLevelMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="1,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator" BasedOn="{StaticResource AppSeparatorStyle}">
                    <Setter Property="Margin" Value="8,5"/>
                    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_New" Click="FileNew_Click"/>
                <MenuItem Header="Open _Audio…" Click="OpenAudio_Click"/>
                <MenuItem Header="_Load Sequence…" InputGestureText="Ctrl+O" Click="LoadProject_Click"/>
                <MenuItem x:Name="OpenRecentMenuItem" Header="Open _Recent"/>
                <MenuItem Header="_Save Sequence" InputGestureText="Ctrl+S (active)" Click="SaveProject_Click"/>
                <MenuItem Header="Save Sequence _As…" InputGestureText="Ctrl+Shift+S (active)" Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="Load _Movie…" InputGestureText="Ctrl+Shift+O" Click="LoadMovie_Click"/>
                <MenuItem Header="_Save Movie" InputGestureText="Ctrl+S (active)" Click="SaveMovie_Click"/>
                <MenuItem Header="Save Movie _As…" InputGestureText="Ctrl+Shift+S (active)" Click="SaveMovieAs_Click"/>
                <MenuItem Header="_Repair Missing Files…" Click="RepairMissingFiles_Click"/>
                <Separator/>
                <MenuItem Header="_Export Animation JSON…" Click="ExportAnimation_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="FileExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="UndoHistoryMenuItem" Header="Undo _History"
                          SubmenuOpened="UndoHistory_SubmenuOpened">
                    <MenuItem Header="No actions to undo" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Clear Timeline…" Click="Clear_Click"/>
            </MenuItem>
            <MenuItem Header="_Config" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="Servo _Configuration…" Click="ServoConfig_Click"/>
                <MenuItem Header="_URDF Configuration…" Click="UrdfConfig_Click"/>
                <Separator/>
                <MenuItem Header="Set _Paths…" Click="SetFolders_Click"/>
            </MenuItem>
            <MenuItem Header="_Animation Library" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_Create Library Sequence…" Click="LibraryCreate_Click"/>
                <MenuItem Header="_Insert Library Sequence…" Click="LibraryInsert_Click"/>
                <Separator/>
                <MenuItem Header="_Manage Library Sequences…" Click="LibraryManage_Click"/>
                <MenuItem Header="Manage Library _Poses…" Click="LibraryCommandsManage_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenuItem" Header="_Help" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem x:Name="HelpContentsMenuItem" Header="_Contents &amp; Search…" Click="HelpContents_Click"/>
                <MenuItem x:Name="HelpContextMenuItem" Header="_Context Help" InputGestureText="F1" Click="HelpContext_Click"/>
                <MenuItem x:Name="HelpControlsMenuItem" Header="Controls &amp; _Hotkeys…" Click="HelpControls_Click"/>
                <Separator/>
                <MenuItem Header="_About Animation Editor &amp; Player" Click="About_Click"/>
            </MenuItem>
        </Menu>

            </Grid>
        </Border>

        <!-- Sequence name/status followed by its read-only description. -->
        <Border x:Name="SequenceDescriptionPanel" Grid.Row="1" Grid.Column="0" Background="{DynamicResource SequencePanelBackground}" Padding="8,6"
                Margin="6,5,6,0" CornerRadius="{StaticResource PanelCornerRadius}"
                BorderBrush="{DynamicResource SequenceAccent}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource SequenceBadgeBackground}" CornerRadius="{StaticResource ControlCornerRadius}"
                        Height="18" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="SEQUENCE" Foreground="#DCEBFA" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SequenceFileText" Text="Sequence: (unsaved)* — 0 s"
                           Foreground="{DynamicResource WarningText}" FontFamily="Consolas" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Current sequence file; * means unsaved changes"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description:" Foreground="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="1" x:Name="SequenceDescriptionText" Foreground="{DynamicResource PrimaryText}"
                               TextWrapping="Wrap" VerticalAlignment="Center"><Run x:Name="SequenceDescriptionRun"/><Run Text="  "/><Hyperlink
                            x:Name="SequenceDescriptionEditButton" FontSize="11" FontWeight="Bold" TextDecorations="{x:Null}"
                            Foreground="{DynamicResource PrimaryText}" ToolTip="Edit the sequence description"
                            Click="SequenceDescriptionEdit_Click">edit</Hyperlink></TextBlock>
                </Grid>
            </Grid>
        </Border>



            <Border x:Name="CommandsAtPointPanel" Grid.Row="2" Grid.Column="0"
                    Background="{DynamicResource PanelBackground}" Margin="6,5,0,0"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,4,8,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="3" x:Name="CommandsAtPointHeader" Text="Commands at cursor: (none)"
                                   Foreground="{DynamicResource HeaderText}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                        <Button Grid.Column="0" Content="+ Add" Margin="4,0" Click="CommandsAtPointAdd_Click"/>
                        <Button x:Name="CommandsAtPointEditButton" Grid.Column="1" Content="Edit" Margin="4,0" Click="CommandsAtPointEdit_Click"/>
                        <Button x:Name="CommandsAtPointDeleteButton" Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="CommandsAtPointDelete_Click"/>
                        <Button x:Name="DockUrdfButton" Grid.Column="4" Content="Dock URDF" Margin="6,0,0,0"
                                Visibility="Collapsed" ToolTip="Dock the detached URDF beside Commands" Click="DockUrdf_Click"/>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="19,7,23,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30*"/><ColumnDefinition Width="50*"/><ColumnDefinition Width="9*"/><ColumnDefinition Width="11*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="CONTROL" Style="{StaticResource SectionCaption}"/>
                        <TextBlock Grid.Column="1" Text="VALUE" Style="{StaticResource SectionCaption}"/>
                        <TextBlock Grid.Column="2" Text="SPEED" Style="{StaticResource SectionCaption}"/>
                        <TextBlock Grid.Column="3" Text="TIME (s)" Style="{StaticResource SectionCaption}" TextAlignment="Right"/>
                    </Grid>
                    <ListBox x:Name="CommandsAtPointList" Margin="8,2,8,6" SelectionMode="Single"
                             SelectionChanged="CommandsAtPointList_SelectionChanged"
                             MouseDoubleClick="CommandsAtPointList_MouseDoubleClick"
                             PreviewKeyDown="CommandsAtPointList_PreviewKeyDown"
                             ToolTip="Double-click to edit; Delete removes the selected command" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid ToolTip="{Binding Details}" MinHeight="23">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30*"/><ColumnDefinition Width="50*"/><ColumnDefinition Width="9*"/><ColumnDefinition Width="11*"/></Grid.ColumnDefinitions>
                                <Border Width="3" CornerRadius="1.5" Height="17" Background="{Binding AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="0" Text="{Binding NameText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,7,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" TextWrapping="Wrap" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding SpeedText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding TimeText}" TextTrimming="CharacterEllipsis" FontFamily="Consolas" Foreground="{DynamicResource SecondaryText}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="UrdfColumnSplitter" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="7"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource DividerBrush}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ToolTip="Drag to resize Commands / URDF model"/>

            <!-- RIGHT: embedded URDF. While docked it spans the editor/audio/spline
                 rows and its visible height is continuously controlled by the
                 bottom-center drag handle inside RobotHeadView. -->
            <Border x:Name="RobotHeadEmbeddedBorder" Grid.Row="0" Grid.Column="2"
                    Margin="0,5,6,0" Panel.ZIndex="30" VerticalAlignment="Top"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <local:RobotHeadView x:Name="EmbeddedHeadView"/>
            </Border>

            <!-- Relative height splitter between editor and audio timeline. -->
            <GridSplitter x:Name="CommandsTimelineSplitter" Grid.Row="3" Grid.ColumnSpan="4" Height="7"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{DynamicResource DividerBrush}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ToolTip="Drag to resize Commands / audio timeline"/>

            <!-- Audio waveform timeline. -->
            <Grid x:Name="AudioTimelineArea" Grid.Row="4" Grid.ColumnSpan="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <AdornerDecorator Grid.Row="1">
                <Grid x:Name="AudioPlotHost">
                <local:WaveformView x:Name="Waveform"/>
                <Border x:Name="SequenceEmptyStatePanel" Panel.ZIndex="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ElevatedPanelBackground}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Start a sequence" Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open Sequence…" Padding="10,4" Margin="0,0,5,0" Click="EmptyOpenSequence_Click"/>
                            <Button Content="Insert Audio…" Padding="10,4" Click="EmptyInsertAudio_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </Grid>
                </AdornerDecorator>
            </Grid>

            <!-- Relative height splitter between audio and spline timelines. -->
            <GridSplitter x:Name="AudioSplineSplitter" Grid.Row="5" Grid.ColumnSpan="4" Height="7"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{DynamicResource DividerBrush}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          Visibility="{Binding Visibility, ElementName=SplineArea}"
                          ToolTip="Drag to resize the audio / spline timelines"/>

            <Border x:Name="SplineArea" Grid.Row="6" Grid.ColumnSpan="4" MinHeight="80"
                    Visibility="Collapsed" Margin="0,4,0,0"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="SplineAreaGrid">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <AdornerDecorator Grid.Row="1">
                        <Grid x:Name="SplinePlotHost"><local:SplineView x:Name="Spline"/></Grid>
                    </AdornerDecorator>

                    <Grid x:Name="SplineLegendStrip" Grid.Row="0" Margin="8,4">
                        <!-- Legend: colored square + name + show/hide box -->
                        <ItemsControl x:Name="SplineLegend">
                            <ItemsControl.ItemsSource>
                                <CompositeCollection>
                                    <CollectionContainer/>
                                    <Button x:Name="SplineShowAllButton" Content="show all"
                                            Visibility="Collapsed" FontSize="11" Height="25" MinHeight="0" Padding="7,0" Margin="0,2"
                                            ToolTip="Show every enabled spline line" Click="SplineShowAll_Click"/>
                                </CompositeCollection>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:SplineLegendItem}">
                                    <Border CornerRadius="11" BorderThickness="1" Padding="7,3" Margin="0,2,6,2">
                                        <Border.Style><Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ElevatedPanelBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/></Trigger>
                                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.48" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style></Border.Style>
                                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" Click="LegendToggle_Click" VerticalContentAlignment="Center"
                                                  ToolTip="Show or hide this spline curve">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="13" Height="13" Margin="4,0,5,0" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>
</Window>
