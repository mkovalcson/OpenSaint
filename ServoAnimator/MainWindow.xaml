<Window x:Class="ServoAnimator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServoAnimator"
        Title="Animation Editor &amp; Player"
        Width="1250" Height="880"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource AppBackground}">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo"
                        Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo"
                        Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>


    <Window.Resources>
        <local:HalfHeightConverter x:Key="HalfHeightConverter"/>

        <!-- ==============================================================
             Shared template for one servo row (used by BOTH grid columns).
             Columns: ServoName | Offset | Speed | Value | slider-or-text
             (the separate numeric "Type" entry column has been removed -
             the slider is the value editor for numeric servos).
             A 2px bottom border appears on rows flagged DividerBelow=True,
             drawing the group separator lines inside each column.
             ============================================================== -->
        <DataTemplate x:Key="ServoRowTemplate">
            <Border BorderBrush="{DynamicResource ControlBorder}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DividerBelow}" Value="True">
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Setter Property="Padding" Value="0,0,0,2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SubDividerBelow}" Value="True">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Margin" Value="0,0,0,1"/>
                                <Setter Property="Padding" Value="0,0,0,1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Border Background="{DynamicResource ElevatedPanelBackground}" Padding="6,1" Margin="0,1,0,1"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,0,1"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GroupHeader}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Width="20" Height="16" MinHeight="0" Padding="0"
                                          FontSize="10" ToolTip="Collapse or expand this servo group"
                                          Click="ServoGroupToggle_Click">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="▾"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GroupCollapsed}" Value="True">
                                                <Setter Property="Content" Value="▸"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="{Binding GroupHeader}" Foreground="{DynamicResource HeaderText}"
                                       FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                <Grid Margin="0,1" Visibility="{Binding RowVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- "Spline" checkbox: when ticked this servo's command
                         points are Hermite-interpolated and drawn in the
                         spline area below the waveform; saving generates
                         sampled commands along the curve. Hidden for
                         text-valued servos (RGBCommand). -->
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsChecked="{Binding SplineEnabled, Mode=TwoWay}"
                              Click="SplineCheck_Click">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextRow}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- ServoName with a [+/-] expander that exposes the
                         ganged RobotControls sub-rows beneath the row. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton Width="17" Height="17" Margin="0,0,4,0"
                                      FontWeight="Bold" Padding="0"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="Content" Value="+"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="−"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <TextBlock Text="{Binding ServoName}" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding OffsetText}" Foreground="#B9BFCA" VerticalAlignment="Center"/>
                    <!-- Speed column: a picklist (Default, Fast, Slow,
                         Crawl) selectable in Live Drive - changing it pushes
                         the speed/accel pair (indexed by the enum) to every
                         servo in the row's gang. Hidden for RGBCommand and
                         the eye pops, which have no speed concept. -->
                    <ComboBox Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" MinWidth="90"
                              ItemsSource="{Binding SpeedOptions}"
                              SelectedItem="{Binding Speed, Mode=TwoWay}"
                              IsEnabled="{Binding SpeedEnabled}"
                              SelectionChanged="RowSpeed_Changed">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSpeed}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <!-- Value column: the number for numeric servos; for
                         the RGBCommand row, a small box filled with the
                         selected palette color instead of a number. -->
                    <TextBlock Grid.Column="4" Text="{Binding ValueText}"  Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextRow}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="4" Width="26" Height="13"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{Binding ColorBrush}"
                            BorderBrush="{DynamicResource HeaderText}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextRow}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- NUMERIC servos: slider (range per servo). Editable in
                         Live Drive; user moves call MoveServoNow(). -->
                    <Slider Grid.Column="5"
                            Minimum="{Binding Min}" Maximum="{Binding Max}"
                            Margin="6,0" VerticalAlignment="Center"
                            IsEnabled="{Binding SliderEnabled}"
                            Value="{Binding Value, Mode=TwoWay}"
                            ValueChanged="RowSlider_ValueChanged"
                            GotKeyboardFocus="RowEditor_GotFocus"
                            LostKeyboardFocus="RowEditor_LostFocus">
                        <Slider.Style>
                            <Style TargetType="Slider">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextRow}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>

                    <!-- TEXT-valued servo (RGBCommand): shows/edits the last
                         command text used (editable in Live Drive). -->
                    <TextBox Grid.Column="5"
                             Margin="6,0" VerticalAlignment="Center"
                             IsEnabled="{Binding SliderEnabled}"
                             Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             KeyDown="RowRgbBox_KeyDown"
                             LostFocus="RowRgbBox_LostFocus"
                             GotKeyboardFocus="RowEditor_GotFocus"
                             LostKeyboardFocus="RowEditor_LostFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextRow}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Expanded RobotControls sub-rows: control name + a PWM
                     verify slider (range from the servo configuration).
                     Sliders are enabled in Live Drive and call
                     MoveRobotControlNow(). Timeline rule: an individual
                     control's command overrides the gang for that servo
                     until the next ganged command. -->
                <ItemsControl ItemsSource="{Binding Children}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="195"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="#9FB3CF" VerticalAlignment="Center"/>
                                <!-- Same range as the PARENT ganged servo
                                     (-100..100 or 0..100); Live Drive moves
                                     drive just this servo through
                                     MapDeltatoServo. -->
                                <Slider Grid.Column="2" Margin="6,0" VerticalAlignment="Center"
                                        Minimum="{Binding Min}" Maximum="{Binding Max}"
                                        IsEnabled="{Binding SliderEnabled}"
                                        Value="{Binding Value, Mode=TwoWay}"
                                        ValueChanged="ChildSlider_ValueChanged"/>
                                <TextBlock Grid.Column="3" Text="{Binding Value, StringFormat=F0}"
                                           Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Column header shared by both grid columns -->
        <DataTemplate x:Key="ServoHeaderTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Spline"    Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="ServoName" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Offset"    Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="Speed"     Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="Value"     Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="Value (slider / text)" Foreground="{DynamicResource HeaderText}" FontWeight="Bold" Margin="6,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>


    <!-- ==================================================================
         Layout (top to bottom):
           1. Toolbar        - file operations, clear, live drive, name
           2. Servo grid     - last state of every servo + live-drive sliders
           3. Waveform       - SkiaSharp timeline (fills remaining space)
           4. Scrollbar      - horizontal scroll for the waveform
           5. Transport      - play/pause, zoom, time readout
           6. Commands list  - all commands at the selected cursor position
         ================================================================== -->
    <DockPanel>

        <!-- ============ 1. MENU BAR ============
             Replaces the old button toolbar. Live Drive and the animation
             name are stateful controls so they live in a slim bar below. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

        <Menu Grid.Column="0" Background="{DynamicResource MenuBackground}" Padding="4,2">
            <Menu.Resources>
                <!-- Individual menu commands use whitespace only. Visible lines
                     come exclusively from explicit Separator elements, which
                     are reserved for true command groups. -->
                <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}">
                    <Setter Property="Foreground" Value="#20242A"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="1,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="TopLevelMenuItem" TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="1,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator" BasedOn="{StaticResource AppSeparatorStyle}">
                    <Setter Property="Margin" Value="8,5"/>
                    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_New" Click="FileNew_Click"/>
                <MenuItem Header="Open _Audio…" Click="OpenAudio_Click"/>
                <MenuItem Header="_Load Sequence…" Click="LoadProject_Click"/>
                <MenuItem x:Name="OpenRecentMenuItem" Header="Open _Recent"/>
                <MenuItem Header="_Save Sequence" Click="SaveProject_Click"/>
                <MenuItem Header="Save Sequence _As…" Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="Load _Movie…" Click="LoadMovie_Click"/>
                <MenuItem Header="_Save Movie" Click="SaveMovie_Click"/>
                <MenuItem Header="Save Movie _As…" Click="SaveMovieAs_Click"/>
                <Separator/>
                <MenuItem Header="_Export Animation JSON…" Click="ExportAnimation_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="FileExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Clear Timeline…" Click="Clear_Click"/>
            </MenuItem>
            <MenuItem Header="_Config" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="Servo _Configuration…" Click="ServoConfig_Click"/>
                <MenuItem Header="_URDF Configuration…" Click="UrdfConfig_Click"/>
                <Separator/>
                <MenuItem Header="Set _Paths…" Click="SetFolders_Click"/>
            </MenuItem>
            <MenuItem Header="_Animation Library" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_Create Library Item…" Click="LibraryCreate_Click"/>
                <MenuItem Header="_Insert Library Sequence…" Click="LibraryInsert_Click"/>
                <Separator/>
                <MenuItem Header="_Manage Library Items…" Click="LibraryManage_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem x:Name="ViewMovieTimelineMenuItem" Header="_Movie Timeline" IsCheckable="True"
                          Click="ViewMovieTimeline_Click"/>
                <Separator/>
                <MenuItem Header="Color _Theme">
                    <MenuItem x:Name="ThemeGraphiteMenuItem" Header="Graphite (Default)" IsCheckable="True"
                              Tag="Graphite" Click="ThemeMenuItem_Click"/>
                    <MenuItem x:Name="ThemeSteelBlueMenuItem" Header="Steel Blue" IsCheckable="True"
                              Tag="Steel Blue" Click="ThemeMenuItem_Click"/>
                    <MenuItem x:Name="ThemeTealMenuItem" Header="Teal" IsCheckable="True"
                              Tag="Teal" Click="ThemeMenuItem_Click"/>
                    <MenuItem x:Name="ThemeVioletMenuItem" Header="Violet" IsCheckable="True"
                              Tag="Violet" Click="ThemeMenuItem_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="Controls &amp; _Hotkeys…" Click="HelpControls_Click"/>
                <Separator/>
                <MenuItem Header="_About Animation Editor &amp; Player" Click="About_Click"/>
            </MenuItem>
        </Menu>

                <!-- Hardware labels are always visible. Status circles stay hidden
                     until Live Drive has made its first USB connection attempt. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,10,0">
                    <ToggleButton x:Name="LiveDriveBtn" Height="20" MinHeight="0" Padding="8,0" Margin="0,0,8,0"
                                  VerticalAlignment="Center" Checked="LiveDrive_Changed" Unchecked="LiveDrive_Changed">
                        <TextBlock><Run Text="● Live Drive: "/><Run x:Name="LiveDriveState" Text="Off" FontWeight="Bold"/></TextBlock>
                    </ToggleButton>
                    <Button Content="Disable Servos" Height="20" Foreground="#FFFF00" MinHeight="0" Padding="8,0"
                            Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="Disable PWM on every Maestro servo channel (servos go limp)"
                            Click="DisableAll_Click"/>
                    <Button Content="Reset" Height="20" MinHeight="0" Padding="8,0"
                            Margin="0,0,14,0" VerticalAlignment="Center"
                            ToolTip="Move Maestro servos to configured Default PWM, set both Eye Pops to 0, and send ClearAll to the Arduino"
                            Click="ResetAll_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse x:Name="MaestroStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Maestro" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse x:Name="ArduinoStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Arduino" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse x:Name="LeftTicStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Left Tic 249" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RightTicStatusDot" Width="10" Height="10" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Right Tic 249" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sequence work area header and one-line description. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SequencePanelBackground}" Padding="8,6"
                Margin="6,5,6,0" CornerRadius="{StaticResource PanelCornerRadius}"
                BorderBrush="{DynamicResource SequenceAccent}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SequenceBadgeBackground}" CornerRadius="{StaticResource ControlCornerRadius}"
                        Height="18" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="SEQUENCE" Foreground="#DCEBFA" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="Description:" Foreground="#C8CCD4"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Grid.Column="2" x:Name="DescriptionBox" MinWidth="240" Height="34"
                         VerticalAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                         TextChanged="DescriptionBox_TextChanged"/>
                <Button Grid.Column="3" x:Name="DescriptionExpandButton" Content="Expand" Height="18" MinHeight="0"
                        Padding="8,0" Margin="6,0,8,0" VerticalAlignment="Center" ToolTip="Expand the sequence description over the servo grid"
                        Click="DescriptionExpand_Click"/>
                <TextBlock Grid.Column="4" x:Name="SequenceFileText" Text="Sequence: (unsaved) *"
                           Foreground="{DynamicResource WarningText}" FontFamily="Consolas" VerticalAlignment="Center"
                           MaxWidth="240" TextTrimming="CharacterEllipsis"
                           ToolTip="Current sequence file; * means unsaved changes"/>
            </Grid>
        </Border>


        <!-- Compact non-modal status line for successful operations. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBackground}" Height="26"
                Margin="6,2,6,5" CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource SecondaryText}"
                       VerticalAlignment="Center" Margin="8,0"/>
        </Border>


        <!-- ============ MOVIE TIMELINE ============ -->
        <Border DockPanel.Dock="Bottom" x:Name="MovieTimelinePanel" Visibility="Collapsed" Height="132"
                Background="{DynamicResource MoviePanelBackground}" BorderBrush="{DynamicResource MovieAccent}" BorderThickness="1"
                Margin="6,4,6,0" CornerRadius="{StaticResource PanelCornerRadius}" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MovieDescriptionExpandedRow" Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Expanded movie description is part of the bottom movie area.
                     Increasing MovieTimelinePanel.Height makes this grow upward. -->
                <Border x:Name="MovieDescriptionExpandedPanel" Grid.Row="0" Visibility="Collapsed"
                        Margin="0,0,0,6" Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource FocusBorder}" BorderThickness="1" Padding="10"
                        CornerRadius="{StaticResource PanelCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="Movie Description" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Collapse" Padding="8,3" Click="MovieDescriptionCollapse_Click"/>
                        </DockPanel>
                        <TextBox Grid.Row="1" x:Name="MovieDescriptionExpandedBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}"
                                 BorderBrush="{DynamicResource DividerBrush}" Padding="8"
                                 TextChanged="MovieDescriptionExpandedBox_TextChanged"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                    <local:MovieTimelineView x:Name="MovieTimeline" Grid.Row="0" Margin="0,0,0,2" Focusable="True"/>
                    <ScrollBar x:Name="MovieScroll" Grid.Row="1" Orientation="Horizontal" Height="14" Scroll="MovieScroll_Scroll"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource MovieBadgeBackground}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,3" Margin="0,2,8,2">
                        <TextBlock Text="MOVIE" Foreground="#FFF1D8" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MoviePlayButton" Content="▶ Movie" Width="82" Margin="0,0,4,0"
                                ToolTip="Play/Pause movie sequence — Up Arrow" Click="MoviePlay_Click"/>
                        <Button x:Name="MovieNextButton" Content="▶|" Width="42"
                                ToolTip="Play next sequence — Right Arrow" Click="MovieNext_Click"/>
                        <Button Content="−" Width="30" Margin="5,0,2,0" ToolTip="Zoom movie timeline out" Click="MovieZoomOut_Click"/>
                        <Button Content="+" Width="30" Margin="2,0" ToolTip="Zoom movie timeline in" Click="MovieZoomIn_Click"/>
                        <Button Content="Fit" Width="42" Margin="2,0" ToolTip="Fit complete movie" Click="MovieZoomFit_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="Movie: " Foreground="#C8CCD4" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MovieFileText" Text="(unsaved) *" Foreground="{DynamicResource WarningText}"
                                   VerticalAlignment="Center" FontFamily="Consolas" MaxWidth="155" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" x:Name="MovieCreatedText" Text="Created:" Foreground="#9F927B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="  Description:" Foreground="#C8CCD4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox Grid.Column="5" x:Name="MovieDescriptionBox" MinWidth="180" Height="32" VerticalAlignment="Center"
                             AcceptsReturn="False" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden"
                             VerticalScrollBarVisibility="Hidden" TextChanged="MovieDescriptionBox_TextChanged"/>
                    <Button Grid.Column="6" x:Name="MovieDescriptionExpandButton" Content="Expand" Padding="8,3" Margin="6,0,0,0"
                            ToolTip="Expand the movie description upward from the movie area" Click="MovieDescriptionExpand_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ SEQUENCE TRANSPORT ============ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SequencePanelBackground}"
                BorderBrush="{DynamicResource SequenceAccent}" BorderThickness="1" Padding="8,6"
                Margin="6,4,6,0" CornerRadius="{StaticResource PanelCornerRadius}">
            <StackPanel Orientation="Horizontal">
                <Button Content="|◀" Width="42" Margin="0,0,4,0" ToolTip="Move sequence cursor to beginning" Click="SequenceRestart_Click"/>
                <Button x:Name="PlayPauseBtn" Content="▶ Sequence" Width="100" Click="PlayPause_Click"/>
                <Button Content="■" Width="42" Margin="4,0,0,0" ToolTip="Stop sequence playback" Click="SequenceStop_Click"/>
                <TextBlock Text="  Time: " Foreground="#C8CCD4" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Text="0.000 s" Foreground="{DynamicResource WarningText}" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center" Width="110"/>
                <TextBlock Text="Volume:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="4,0,5,0"/>
                <Slider x:Name="VolumeSlider" Width="105" Minimum="0" Maximum="100" Value="100"
                        TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                        ToolTip="Audio playback volume" ValueChanged="PlaybackVolume_Changed"/>
                <TextBlock x:Name="VolumeText" Text="100%" Foreground="{DynamicResource SecondaryText}"
                           Width="42" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <Separator Width="14" Background="Transparent"/>
                <Button Content="Zoom −" Padding="8,2" Margin="2,0" Click="ZoomOut_Click"/>
                <Button Content="Zoom +" Padding="8,2" Margin="2,0" Click="ZoomIn_Click"/>
                <Button Content="Fit" Padding="8,2" Margin="2,0" Click="ZoomFit_Click"/>
                <ToggleButton x:Name="MovieTimelineToggle" Content="Movie Timeline" Padding="8,2" Margin="10,0,2,0"
                              IsChecked="False" ToolTip="Show or hide the movie timeline"
                              Checked="MovieTimelineToggle_Changed" Unchecked="MovieTimelineToggle_Changed"/>
                <ToggleButton x:Name="CommandsListToggle" Content="Hide Commands" Padding="8,2" Margin="4,0,2,0"
                              IsChecked="True" ToolTip="Show or hide the Commands view below the spline"
                              Checked="CommandsListToggle_Changed" Unchecked="CommandsListToggle_Changed"/>
                <Button Content="?" Width="30" Margin="6,0,0,0" ToolTip="Controls and hotkeys" Click="HelpControls_Click"/>
                <TextBlock Text="   wheel zoom • middle-drag pan • right-click actions" Foreground="#78818E" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============ 4. SCROLLBAR ============ -->
        <ScrollBar DockPanel.Dock="Bottom" x:Name="HScroll" Orientation="Horizontal"
                   Height="16" Scroll="HScroll_Scroll"/>

        <!-- ==================================================================
             CENTER AREA: servo status grid over the waveform, separated by a
             draggable GridSplitter handle. Dragging the handle down gives the
             servo grid more height (more rows visible) and shrinks the
             waveform; dragging up does the opposite. Min heights keep both
             panes usable.
             ================================================================== -->
        <Grid x:Name="EditorTimelineGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ServoEditorColumn" Width="*" MinWidth="280"/>
                <ColumnDefinition x:Name="UrdfSplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="UrdfEditorColumn" Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopEditorRow" Height="250" MinHeight="80"/> <!-- grid + URDF -->
                <RowDefinition Height="Auto"/>                                      <!-- editor/audio splitter -->
                <RowDefinition x:Name="AudioTimelineRow" Height="*" MinHeight="120"/> <!-- audio -->
                <RowDefinition Height="Auto"/>                                      <!-- audio/spline splitter -->
                <RowDefinition x:Name="SplineTimelineRow" Height="0"/>              <!-- spline -->
                <RowDefinition x:Name="CommandsTimelineRow" Height="Auto"/>         <!-- commands -->
            </Grid.RowDefinitions>

            <!-- LEFT: servo grid. While the URDF is docked this is the familiar
                 single-column editor. When the URDF is undocked, code expands this
                 border across the former URDF columns and switches to a two-column
                 section layout: Eye Flaps through Neck on the left, then Lighting &
                 Vents through Headtop Controls on the right. -->
            <Border x:Name="ServoGridBorder" Grid.Row="0" Grid.Column="0" Margin="6,5,0,0"
                    Background="{DynamicResource PanelBackground}" Padding="8,5"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <Grid>
                    <ScrollViewer x:Name="DockedServoGridScroll"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ContentPresenter ContentTemplate="{StaticResource ServoHeaderTemplate}" Content="{x:Null}" Margin="0,0,0,2"/>
                            <ItemsControl x:Name="ServoGridEyeFlaps" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            <ItemsControl x:Name="ServoGridNose" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            <ItemsControl x:Name="ServoGridEyes" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            <ItemsControl x:Name="ServoGridNeck" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            <ItemsControl x:Name="ServoGridLightingVents" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            <ItemsControl x:Name="ServoGridEyePop" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            <ItemsControl x:Name="ServoGridHeadtop" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="UndockedServoGridColumns" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="UndockedServoLeftColumn" Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition x:Name="UndockedServoRightColumn" Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0">
                            <StackPanel>
                                <ContentPresenter ContentTemplate="{StaticResource ServoHeaderTemplate}" Content="{x:Null}" Margin="0,0,0,2"/>
                                <ItemsControl x:Name="UndockedServoGridEyeFlaps" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                                <ItemsControl x:Name="UndockedServoGridNose" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                                <ItemsControl x:Name="UndockedServoGridEyes" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                                <ItemsControl x:Name="UndockedServoGridNeck" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{DynamicResource DividerBrush}" ShowsPreview="False"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                      ToolTip="Drag to resize the two servo-section columns"/>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4,0,0,0">
                            <StackPanel>
                                <ContentPresenter ContentTemplate="{StaticResource ServoHeaderTemplate}" Content="{x:Null}" Margin="0,0,0,2"/>
                                <ItemsControl x:Name="UndockedServoGridLightingVents" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                                <ItemsControl x:Name="UndockedServoGridEyePop" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                                <ItemsControl x:Name="UndockedServoGridHeadtop" ItemTemplate="{StaticResource ServoRowTemplate}"/>
                                <Button x:Name="DockUrdfFromGridButton" Content="Dock"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"
                                        ToolTip="Dock the URDF model back into the editor"
                                        Click="DockUrdfFromGrid_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Relative width splitter between the servo grid and embedded URDF. -->
            <GridSplitter x:Name="UrdfColumnSplitter" Grid.Row="0" Grid.Column="1" Width="7"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource DividerBrush}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ToolTip="Drag to resize the servo grid / URDF model"/>

            <!-- RIGHT: embedded URDF. While docked it spans the editor/audio/spline
                 rows and its visible height is continuously controlled by the
                 bottom-center drag handle inside RobotHeadView. -->
            <Border x:Name="RobotHeadEmbeddedBorder" Grid.Row="0" Grid.Column="2"
                    Margin="0,5,6,0" Panel.ZIndex="30"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <local:RobotHeadView x:Name="EmbeddedHeadView"/>
            </Border>

            <!-- Expanded sequence description occupies the left editor pane. -->
            <Border x:Name="DescriptionOverlay" Grid.Row="0" Grid.Column="0" Panel.ZIndex="40"
                    Margin="6,5,0,0" Visibility="Collapsed" VerticalAlignment="Top"
                    Height="{Binding ActualHeight, ElementName=ServoGridBorder, Converter={StaticResource HalfHeightConverter}}"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource FocusBorder}" BorderThickness="1" Padding="10"
                    CornerRadius="{StaticResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="Description" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Collapse" Padding="8,3" Click="DescriptionCollapse_Click"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="DescriptionExpandedBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}"
                             BorderBrush="{DynamicResource DividerBrush}" Padding="8"
                             TextChanged="DescriptionExpandedBox_TextChanged"/>
                </Grid>
            </Border>


            <!-- Relative height splitter between editor and audio timeline. -->
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="7"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{DynamicResource DividerBrush}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ToolTip="Drag to resize the editor / audio timeline"/>

            <!-- Audio waveform timeline. -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <local:WaveformView x:Name="Waveform"/>
            </Grid>

            <!-- Relative height splitter between audio and spline timelines. -->
            <GridSplitter x:Name="AudioSplineSplitter" Grid.Row="3" Grid.ColumnSpan="3" Height="7"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{DynamicResource DividerBrush}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          Visibility="{Binding Visibility, ElementName=SplineArea}"
                          ToolTip="Drag to resize the audio / spline timelines"/>

            <Border x:Name="SplineArea" Grid.Row="4" Grid.ColumnSpan="3" MinHeight="80"
                    Visibility="Collapsed" Margin="0,4,0,0"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <local:SplineView x:Name="Spline"/>

                    <DockPanel VerticalAlignment="Top" Margin="8,4">
                        <!-- Sample-rate picklist (upper right) -->
                        <TextBlock DockPanel.Dock="Right" x:Name="SplineInspectorText"
                                   Text="Hover a spline for exact time/value" Foreground="#B9BFCA"
                                   Background="{DynamicResource InspectorBackground}" Padding="6,2" Margin="12,0,0,0"/>
                        <!-- Legend: colored square + name + show/hide box -->
                        <ItemsControl x:Name="SplineLegend">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding Visible, Mode=TwoWay}"
                                                  Click="LegendToggle_Click"/>
                                        <Rectangle Width="12" Height="12" Margin="4,0"
                                                   Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{Binding Brush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Commands inspector sits directly below the spline (or below the
                 audio timeline when no splines are enabled), above the movie area. -->
            <Border x:Name="CommandsAtPointPanel" Grid.Row="5" Grid.ColumnSpan="3"
                    Background="{DynamicResource PanelBackground}" Margin="6,4,6,0"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,4,8,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="CommandsAtPointHeader" Text="Commands at cursor: (none)"
                                   Foreground="{DynamicResource HeaderText}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Add" Margin="4,0" Click="CommandsAtPointAdd_Click"/>
                        <Button Grid.Column="2" Content="Edit" Margin="4,0" Click="CommandsAtPointEdit_Click"/>
                        <Button Grid.Column="3" Content="Delete" Margin="4,0,0,0" Click="CommandsAtPointDelete_Click"/>
                    </Grid>
                    <ListBox x:Name="CommandsAtPointList" Height="72" Margin="8,2,8,6" SelectionMode="Single"
                             MouseDoubleClick="CommandsAtPointList_MouseDoubleClick"
                             PreviewKeyDown="CommandsAtPointList_PreviewKeyDown"
                             ToolTip="Double-click to edit; Delete removes the selected command"/>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
