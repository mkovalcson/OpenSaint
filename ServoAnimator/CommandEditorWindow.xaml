<Window x:Class="ServoAnimator.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Commands"
        Width="1030" Height="640" MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

    <!-- ==================================================================
         Modal editor for all commands at one timeline point.
         Each row edits one ServoCommand: Offset | Servo | Value slider |
         Value textbox | Disable | Speed (N/C by default) | Delete.

         Value editing is per-servo:
           * numeric servos: slider whose Min/Max come from the view-model
             (0..2000 for LeftEyePop/RightEyePop, -100..100 otherwise),
             plus a numeric TextBox. Moving either calls MoveServoNow().
           * RGBCommand: the slider/number are replaced by a free-text box
             plus Build…; the URDF eye/vent rings provide the visual preview.

         Rows bind to draft commands. Applying merges them with the current
         document after the user resolves any duplicate target/time groups.
         ================================================================== -->
    <DockPanel Margin="10">

        <Border DockPanel.Dock="Top" Background="{DynamicResource ElevatedPanelBackground}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Adjust the controls at this time point. Changes stay in a draft until you apply them."
                           Style="{StaticResource DialogSubtitle}" Margin="0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Speed for all commands:" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryText}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="AllCommandsSpeed" Width="110" Margin="0,0,10,0"/>
                    <Button Content="Set All Speeds" Click="SetAllSpeeds_Click" Padding="12,4"
                            ToolTip="Set the speed for every command in this window that supports a speed profile"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="71.4"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Offset (s)" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Spline" Width="50" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Text="Break Spline" Width="70" TextWrapping="Wrap" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
                <TextBlock Text="Servo" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="Value (slider / text)" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Text="Value"      Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="4" Text="Disable"    Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="5" Text="Speed"      Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Create Library Pose" Padding="10,4" Margin="4,0"
                    ToolTip="Save the commands currently shown here as one reusable single-time-point Library Pose"
                    Click="CreateLibraryCommand_Click"/>
            <Button Content="Add Command" Padding="10,4" Margin="4,0" Click="AddCommand_Click"/>
            <Button Content="Apply and Close" Padding="10,4" Margin="4,0" Click="Close_Click" IsDefault="True"/>
            <Button Content="Cancel" Padding="10,4" Margin="4,0" Click="Cancel_Click"/>
        </StackPanel>

        <!-- One editable row per command -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CmdList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="315"/>
                                <ColumnDefinition Width="236"/>
                                <ColumnDefinition Width="71.4"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <!-- offsetSeconds: editing moves the command to a
                                 new point in the timeline -->
                            <TextBox Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource NumericInputStyle}"
                                     Text="{Binding OffsetText, UpdateSourceTrigger=LostFocus}"/>

                            <!-- Servo picklist in Display Grid order: each
                                 ganged ServoName followed by its child
                                 servos prefixed " – ". Picking a child
                                 targets just that servo (parent's range and
                                 gang-relative direction apply) until the
                                 next ganged command. -->
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsChecked="{Binding SplineEnabled, Mode=TwoWay}" IsEnabled="{Binding SupportsSpline}"
                                          ToolTip="{Binding SplineToolTip}" ToolTipService.ShowOnDisabled="True"/>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsChecked="{Binding BreakSpline, Mode=TwoWay}" IsEnabled="{Binding SupportsBreakSpline}"
                                          ToolTip="Hide the spline line from this command to the next point for this control. Playback interpolation is unchanged. Available when Spline is checked."
                                          ToolTipService.ShowOnDisabled="True"/>
                                <ComboBox Grid.Column="2" Margin="0,0,6,0"
                                          ItemsSource="{Binding ServoPickOptions}"
                                          SelectedItem="{Binding SelectedServoItem}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding IconSource}" Width="18" Height="18"
                                                       Margin="0,0,7,0" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- NUMERIC value slider: range bound per servo;
                                 dragging calls MoveServoNow(). Hidden for
                                 text-valued servos (RGBCommand). -->
                            <Slider Grid.Column="2"
                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                    Value="{Binding Value, Mode=TwoWay}">
                                <Slider.Style>
                                    <Style TargetType="Slider" BasedOn="{StaticResource StudioValueSlider}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTextServo}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>

                            <!-- NUMERIC value typed directly -->
                            <TextBox Grid.Column="3" Margin="0,0,6,0"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource NumericInputStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTextServo}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- TEXT value (RGBCommand only): free-form string -->
                            <TextBox Grid.Column="2" Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTextServo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- RGB command builder. The old color-patch/palette
                                 preview is intentionally removed: the URDF now
                                 previews the four physical NeoPixel rings directly. -->
                            <Button Grid.Column="3" Content="Build…" Height="22"
                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                    ToolTip="Build the RGB command text from the Arduino RGB command list"
                                    Click="BuildRgb_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTextServo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Disable: this command turns its servo(s)
                                 OFF instead of moving them; exports write
                                 "Disable" in the value field. -->
                            <CheckBox Grid.Column="4" VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding Disable, Mode=TwoWay}"/>

                            <!-- Optional Maestro speed profile. N/C means
                                 position only: do not change speed/acceleration. -->
                            <ComboBox Grid.Column="5" Margin="0,0,6,0"
                                      ItemsSource="{Binding SpeedOptions}"
                                      SelectedItem="{Binding SpeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupportsSpeed}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <Button Grid.Column="6" Content="Delete" Click="DeleteCommand_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
