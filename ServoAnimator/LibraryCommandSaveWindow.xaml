<Window x:Class="ServoAnimator.LibraryCommandSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Library Command"
        Width="700" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Library Command file name:" FontWeight="Bold"
                   Foreground="{DynamicResource HeaderText}" Margin="0,0,0,4"/>
        <TextBox x:Name="FileNameBox" Grid.Row="1" Height="32"
                 Text="library-command.json" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Description:" FontWeight="Bold"
                   Foreground="{DynamicResource HeaderText}" Margin="0,0,0,4"/>
        <TextBox x:Name="DescriptionBox" Grid.Row="3" Height="135"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="8"/>

        <TextBlock Grid.Row="4" Text="Attached image (optional):" FontWeight="Bold"
                   Foreground="{DynamicResource HeaderText}" Margin="0,12,0,4"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Attach Image…" Padding="10,4" Margin="0,0,8,0"
                    Click="AttachImage_Click"/>
            <TextBlock x:Name="ImagePathText" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}" Text="(none)"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save Library Command" Padding="10,4" Margin="0,0,8,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
