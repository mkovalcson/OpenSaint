<Window x:Class="ServoAnimator.UrdfConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServoAnimator"
        Title="URDF Configuration"
        Width="1420" Height="800"
        MinWidth="1040" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0,0,0,8"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="URDF Range Calibration" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource HeaderText}"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="Degree-based rotation uses a circular calibration dial: Zero is always the horizontal-right reference, while draggable Minimum and Maximum lines show their angular offsets and swap sides when Reversed. Millimetre-based linear motion uses one two-handle line; Zero follows Minimum normally and Maximum when Reversed. Exact values remain editable. Shared gangs keep shared ranges, while FlapsOpen retains independent physical flap ranges. Servo Position previews URDF motion only and never drives physical hardware."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio LED Gain" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="AudioLedGainSlider" Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="2.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="False"
                        ValueChanged="AudioLedGainSlider_ValueChanged" VerticalAlignment="Center"
                        ToolTip="Multiply the normalized audio level driving all URDF mouth LEDs. Range 0.5x to 2.0x."/>
                <TextBox x:Name="AudioLedGainText" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Padding="4,2"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         LostFocus="AudioLedGainText_LostFocus" KeyDown="AudioLedGainText_KeyDown"
                         ToolTip="Audio LED gain multiplier. Enter a value from 0.5 to 2.0."/>
                <TextBlock Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="0.5× = less sensitive   •   1.0× = normal   •   2.0× = more sensitive"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Eye Light Intensity" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center" Margin="0,7,12,0"/>
                <Slider x:Name="EyeLightIntensitySlider" Grid.Row="1" Grid.Column="1" Minimum="1.0" Maximum="20.0"
                        TickFrequency="1.0" IsSnapToTickEnabled="False" Margin="0,7,0,0"
                        ValueChanged="EyeLightIntensitySlider_ValueChanged" VerticalAlignment="Center"
                        ToolTip="URDF-only rendered intensity multiplier for the front-facing eye NeoPixel rings. 1x is the current calibrated appearance; maximum 20x."/>
                <TextBox x:Name="EyeLightIntensityText" Grid.Row="1" Grid.Column="2" Margin="8,7,0,0" Padding="4,2"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         LostFocus="EyeLightIntensityText_LostFocus" KeyDown="EyeLightIntensityText_KeyDown"
                         ToolTip="Front eye light intensity multiplier. Enter a value from 1.0 to 20.0."/>
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="10,7,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="1× = current eye lighting   •   up to 20× brighter"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Vent Light Intensity" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center" Margin="0,7,12,0"/>
                <Slider x:Name="VentLightIntensitySlider" Grid.Row="2" Grid.Column="1" Minimum="1.0" Maximum="20.0"
                        TickFrequency="1.0" IsSnapToTickEnabled="False" Margin="0,7,0,0"
                        ValueChanged="VentLightIntensitySlider_ValueChanged" VerticalAlignment="Center"
                        ToolTip="URDF-only rendered intensity multiplier for the rear-facing vent NeoPixel rings. 1x is the current calibrated appearance; maximum 20x."/>
                <TextBox x:Name="VentLightIntensityText" Grid.Row="2" Grid.Column="2" Margin="8,7,0,0" Padding="4,2"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         LostFocus="VentLightIntensityText_LostFocus" KeyDown="VentLightIntensityText_KeyDown"
                         ToolTip="Vent light intensity multiplier. Enter a value from 1.0 to 20.0."/>
                <TextBlock Grid.Row="2" Grid.Column="3" Margin="10,7,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="1× = current vent lighting   •   up to 20× brighter"/>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="ConfigPathText" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}" Margin="2,0,12,0"/>
            <Button Content="Back" Width="90" Margin="4,0" Click="Back_Click"
                    ToolTip="Restore all URDF Configuration values to the values they had when this window was opened."/>
            <Button Content="Reset Defaults" Width="110" Margin="4,0" Click="ResetDefaults_Click"/>
            <Button Content="Zero Flaps" Width="110" Margin="4,0" Click="ZeroFlaps_Click"
                    ToolTip="Using the current NoseBody and NoseBasket values in the editor grid, set the individual flap zero points so Open/Close and Tilt are horizontal at logical 0."/>
            <Button Content="Save Default" Width="110" Margin="4,0" Click="SaveDefault_Click"
                    ToolTip="Save an optional URDFconfig.json override in the Configuration folder. The calibrated baseline is embedded in johnny5_head.urdf."/>
            <Button Content="Close" Width="90" Margin="4,0,0,0" Click="Close_Click" IsDefault="True"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Servo / Physical Body" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="URDF Range Calibration" Foreground="{DynamicResource HeaderText}" FontWeight="Bold" Margin="8,0"/>
        </Grid>

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                Background="{DynamicResource PanelBackground}" CornerRadius="7"
                                Margin="0,0,0,9" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource HeaderText}" Margin="2,0,0,5"/>

                                <ItemsControl ItemsSource="{Binding Servos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="242"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="2,3,8,0">
                                                        <TextBlock Text="{Binding ServoName}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding InputRangeText}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                                    </StackPanel>

                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Directions}" Margin="8,0,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,5,0,8" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="205"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" Margin="0,3,12,0">
                                                                            <TextBlock Text="{Binding ChildServoName}" Foreground="{DynamicResource WarningText}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="Drag the round handles or type exact values."
                                                                                       Foreground="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsRotational}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="Zero follows Minimum; when Reversed, Zero follows Maximum."
                                                                                       Foreground="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsLinear}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <!-- Rotational calibration: zero reference is always horizontal right. -->
                                                                        <Grid Grid.Column="1" Margin="0,0,4,0">
                                                                            <Grid.Style>
                                                                                <Style TargetType="Grid">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsRotational}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Grid.Style>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="190"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <local:AngularRangeDial Grid.Column="0" Width="174" Height="174" HorizontalAlignment="Left"
                                                                                                    MinimumExtent="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                    MaximumExtent="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                    ZeroExtent="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                    Reverse="{Binding Reverse}"
                                                                                                    EditorMinimum="{Binding ExtentSliderMin}"
                                                                                                    EditorMaximum="{Binding ExtentSliderMax}"
                                                                                                    ToolTip="Zero is fixed horizontally right. Drag the Minimum and Maximum endpoint handles around the circle."/>

                                                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="76"/>
                                                                                    <ColumnDefinition Width="82"/>
                                                                                    <ColumnDefinition Width="34"/>
                                                                                    <ColumnDefinition Width="18"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="116"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,2"
                                                                                         KeyDown="ExtentTextBox_KeyDown" ToolTip="Maximum physical angle in degrees."/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="°" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>

                                                                                <Grid Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Margin="8,0,0,0">
                                                                                    <Grid.Style>
                                                                                        <Style TargetType="Grid">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Grid.Style>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="148"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="50"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0" Text="Servo Position Preview" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}" FontWeight="SemiBold"/>
                                                                                    <Slider Grid.Column="1" Minimum="{Binding InputMin}" Maximum="{Binding InputMax}" Value="{Binding TestPosition, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                                                                    <TextBlock Grid.Column="2" Text="{Binding TestPositionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningText}"/>
                                                                                </Grid>

                                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Zero:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,7,0,0"/>
                                                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,2" Margin="0,7,0,0"
                                                                                         KeyDown="ExtentTextBox_KeyDown" ToolTip="Actual physical angle at logical zero. The drawn zero reference remains horizontal."/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="°" Margin="5,7,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                                                                <Slider Grid.Row="1" Grid.Column="4" Minimum="{Binding ZeroSliderMin}" Maximum="{Binding ZeroSliderMax}"
                                                                                        Value="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="8,7,8,0"
                                                                                        ToolTip="Adjust the actual degree value represented by the fixed horizontal zero reference."/>
                                                                                <CheckBox Grid.Row="1" Grid.Column="5" IsChecked="{Binding Reverse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                          Content="Reversed" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="0,7,0,0"
                                                                                          ToolTip="Reverse swaps which side of the zero line displays Minimum and Maximum movement."/>

                                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimum:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,7,0,0"/>
                                                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,2" Margin="0,7,0,0"
                                                                                         KeyDown="ExtentTextBox_KeyDown" ToolTip="Minimum physical angle in degrees."/>
                                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="°" Margin="5,7,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                                                            </Grid>
                                                                        </Grid>

                                                                        <!-- Linear calibration: one track with two endpoint handles. -->
                                                                        <Grid Grid.Column="1" Margin="0,4,4,0">
                                                                            <Grid.Style>
                                                                                <Style TargetType="Grid">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsLinear}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Grid.Style>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="250"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="250"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="Minimum:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                                                <TextBox Width="88" Text="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,2" Margin="7,0,4,0"
                                                                                         KeyDown="ExtentTextBox_KeyDown" ToolTip="Minimum linear extent in millimetres."/>
                                                                                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                                                            </StackPanel>

                                                                            <Grid Grid.Row="0" Grid.Column="1" Margin="8,0">
                                                                                <Grid.Style>
                                                                                    <Style TargetType="Grid">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Grid.Style>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="148"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="50"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="Servo Position Preview" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}" FontWeight="SemiBold"/>
                                                                                <Slider Grid.Column="1" Minimum="{Binding InputMin}" Maximum="{Binding InputMax}" Value="{Binding TestPosition, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding TestPositionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningText}"/>
                                                                            </Grid>

                                                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                <TextBlock Text="Maximum:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                                                <TextBox Width="88" Text="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="4,2" Margin="7,0,4,0"
                                                                                         KeyDown="ExtentTextBox_KeyDown" ToolTip="Maximum linear extent in millimetres."/>
                                                                                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                                                            </StackPanel>

                                                                            <local:LinearRangeTrack Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="46" Margin="0,5,0,2"
                                                                                                    MinimumExtent="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                    MaximumExtent="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                    Reverse="{Binding Reverse}"
                                                                                                    EditorMinimum="{Binding ExtentSliderMin}" EditorMaximum="{Binding ExtentSliderMax}"
                                                                                                    ToolTip="Drag either endpoint handle. The outlined endpoint is the logical zero position."/>

                                                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                                                                <TextBlock Text="Zero:" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding ZeroExtent, StringFormat={}{0:0.###}}" Foreground="{DynamicResource WarningText}" Margin="7,0,4,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                                <TextBlock Text="mm" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="  (derived from direction)" Foreground="{DynamicResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <CheckBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" IsChecked="{Binding Reverse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Content="Reversed" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                                                                      ToolTip="Normal: Zero = Minimum. Reversed: Zero = Maximum and movement runs toward Minimum."/>
                                                                        </Grid>

                                                                        <!-- Fallback for non-degree/non-mm calibration (currently Iris %). -->
                                                                        <Grid Grid.Column="1" Margin="0,4,4,0">
                                                                            <Grid.Style>
                                                                                <Style TargetType="Grid">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsOther}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Grid.Style>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="40"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding ExtentSliderMin}" Maximum="{Binding ExtentSliderMax}" Value="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" HorizontalContentAlignment="Right" Padding="4,2" Margin="5,0,3,0" KeyDown="ExtentTextBox_KeyDown"/>
                                                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Unit}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                                                            <Grid Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3">
                                                                                <Grid.Style>
                                                                                    <Style TargetType="Grid">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Grid.Style>
                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="Servo Position Preview" VerticalAlignment="Center" Foreground="{DynamicResource HeaderText}" FontWeight="SemiBold"/>
                                                                                <Slider Grid.Column="1" Minimum="{Binding InputMin}" Maximum="{Binding InputMax}" Value="{Binding TestPosition, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding TestPositionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningText}"/>
                                                                            </Grid>

                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Zero:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,6,0,0"/>
                                                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding ZeroSliderMin}" Maximum="{Binding ZeroSliderMax}" Value="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" HorizontalContentAlignment="Right" Padding="4,2" Margin="5,6,3,0" KeyDown="ExtentTextBox_KeyDown"/>
                                                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Unit}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
                                                                            <CheckBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" IsChecked="{Binding Reverse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Reversed" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="0,6,0,0"/>

                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimum:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,6,0,0"/>
                                                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding ExtentSliderMin}" Maximum="{Binding ExtentSliderMax}" Value="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" HorizontalContentAlignment="Right" Padding="4,2" Margin="5,6,3,0" KeyDown="ExtentTextBox_KeyDown"/>
                                                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Unit}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
