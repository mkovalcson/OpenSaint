<Window x:Class="ServoAnimator.UrdfConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URDF Configuration"
        Width="1420" Height="800"
        MinWidth="1040" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0,0,0,8"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="URDF Range Calibration" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource HeaderText}"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="Range calibration is grouped like Servo Configuration. Every physical URDF servo now has an independent editable Zero Point and Direction. Normal gangs share Minimum/Maximum Extents and Servo Position test movement; FlapsOpen keeps independent Min/Max ranges for all four physical Open/Close servos while Upper and Lower pairs remain ganged for test movement. Zero Point is the URDF extent at logical input 0, allowing asymmetric travel around neutral. Use Zero Flaps after setting NoseBody/NoseBasket in the editor grid to calculate horizontal flap zeroes. Calibration defaults are embedded in the URDF model; Save Default writes an optional URDFconfig.json override. Calibration previews URDF motion only and never drives physical hardware."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,7" Margin="0,0,0,8"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio LED Gain" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="AudioLedGainSlider" Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="2.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="False"
                        ValueChanged="AudioLedGainSlider_ValueChanged" VerticalAlignment="Center"
                        ToolTip="Multiply the normalized audio level driving all URDF mouth LEDs. Range 0.5x to 2.0x."/>
                <TextBox x:Name="AudioLedGainText" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Padding="4,2"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         LostFocus="AudioLedGainText_LostFocus" KeyDown="AudioLedGainText_KeyDown"
                         ToolTip="Audio LED gain multiplier. Enter a value from 0.5 to 2.0."/>
                <TextBlock Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="0.5× = less sensitive   •   1.0× = normal   •   2.0× = more sensitive"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Eye Light Intensity" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center" Margin="0,7,12,0"/>
                <Slider x:Name="EyeLightIntensitySlider" Grid.Row="1" Grid.Column="1" Minimum="1.0" Maximum="20.0"
                        TickFrequency="1.0" IsSnapToTickEnabled="False" Margin="0,7,0,0"
                        ValueChanged="EyeLightIntensitySlider_ValueChanged" VerticalAlignment="Center"
                        ToolTip="URDF-only rendered intensity multiplier for the front-facing eye NeoPixel rings. 1x is the current calibrated appearance; maximum 20x."/>
                <TextBox x:Name="EyeLightIntensityText" Grid.Row="1" Grid.Column="2" Margin="8,7,0,0" Padding="4,2"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         LostFocus="EyeLightIntensityText_LostFocus" KeyDown="EyeLightIntensityText_KeyDown"
                         ToolTip="Front eye light intensity multiplier. Enter a value from 1.0 to 20.0."/>
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="10,7,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="1× = current eye lighting   •   up to 20× brighter"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Vent Light Intensity" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderText}" VerticalAlignment="Center" Margin="0,7,12,0"/>
                <Slider x:Name="VentLightIntensitySlider" Grid.Row="2" Grid.Column="1" Minimum="1.0" Maximum="20.0"
                        TickFrequency="1.0" IsSnapToTickEnabled="False" Margin="0,7,0,0"
                        ValueChanged="VentLightIntensitySlider_ValueChanged" VerticalAlignment="Center"
                        ToolTip="URDF-only rendered intensity multiplier for the rear-facing vent NeoPixel rings. 1x is the current calibrated appearance; maximum 20x."/>
                <TextBox x:Name="VentLightIntensityText" Grid.Row="2" Grid.Column="2" Margin="8,7,0,0" Padding="4,2"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         LostFocus="VentLightIntensityText_LostFocus" KeyDown="VentLightIntensityText_KeyDown"
                         ToolTip="Vent light intensity multiplier. Enter a value from 1.0 to 20.0."/>
                <TextBlock Grid.Row="2" Grid.Column="3" Margin="10,7,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="1× = current vent lighting   •   up to 20× brighter"/>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="ConfigPathText" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}" Margin="2,0,12,0"/>
            <Button Content="Back" Width="90" Margin="4,0" Click="Back_Click"
                    ToolTip="Restore all URDF Configuration values to the values they had when this window was opened."/>
            <Button Content="Reset Defaults" Width="110" Margin="4,0" Click="ResetDefaults_Click"/>
            <Button Content="Zero Flaps" Width="110" Margin="4,0" Click="ZeroFlaps_Click"
                    ToolTip="Using the current NoseBody and NoseBasket values in the editor grid, set the individual flap zero points so Open/Close and Tilt are horizontal at logical 0."/>
            <Button Content="Save Default" Width="110" Margin="4,0" Click="SaveDefault_Click"
                    ToolTip="Save an optional URDFconfig.json override in the Configuration folder. The calibrated baseline is embedded in johnny5_head.urdf."/>
            <Button Content="Close" Width="90" Margin="4,0,0,0" Click="Close_Click" IsDefault="True"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Servo Input" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="Minimum Extent" Foreground="{DynamicResource HeaderText}" FontWeight="Bold" Margin="8,0"/>
            <TextBlock Grid.Column="2" Text="Maximum Extent" Foreground="{DynamicResource HeaderText}" FontWeight="Bold" Margin="8,0"/>
            <TextBlock Grid.Column="3" Text="Servo Position (URDF Preview)" Foreground="{DynamicResource HeaderText}" FontWeight="Bold" Margin="8,0"/>
        </Grid>

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                Background="{DynamicResource PanelBackground}" CornerRadius="7"
                                Margin="0,0,0,9" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource HeaderText}" Margin="2,0,0,5"/>

                                <ItemsControl ItemsSource="{Binding Servos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                                    Padding="0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="242"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                                                        <TextBlock Text="{Binding ServoName}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding InputRangeText}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                                    </StackPanel>

                                                    <Grid Grid.Row="0" Grid.Column="1" Margin="8,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSharedRange}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Grid.Column="0" Minimum="{Binding ExtentSliderMin}" Maximum="{Binding ExtentSliderMax}"
                                                                Value="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Drag to change the minimum extent for this URDF servo or gang."/>
                                                        <TextBox Grid.Column="1" Text="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                                 Margin="5,0,3,0" Padding="4,2"
                                                                 KeyDown="ExtentTextBox_KeyDown"
                                                                 ToolTip="Type the minimum extent. Press Enter, Tab, or click elsewhere to apply it."/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SecondaryText}"/>
                                                    </Grid>

                                                    <Grid Grid.Row="0" Grid.Column="2" Margin="8,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSharedRange}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Grid.Column="0" Minimum="{Binding ExtentSliderMin}" Maximum="{Binding ExtentSliderMax}"
                                                                Value="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Drag to change the maximum extent for this URDF servo or gang."/>
                                                        <TextBox Grid.Column="1" Text="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                                 Margin="5,0,3,0" Padding="4,2"
                                                                 KeyDown="ExtentTextBox_KeyDown"
                                                                 ToolTip="Type the maximum extent. Press Enter, Tab, or click elsewhere to apply it."/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SecondaryText}"/>
                                                    </Grid>

                                                    <Grid Grid.Row="0" Grid.Column="3" Margin="8,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                        <Slider Grid.Column="0" Minimum="{Binding InputMin}" Maximum="{Binding InputMax}"
                                                                Value="{Binding TestPosition, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TestPositionText}" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                                  ItemsSource="{Binding Directions}" Margin="18,5,8,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="224"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChildServoName}"
                                                                               Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>

                                                                    <!-- FlapsOpen only: each physical flap owns its own Min extent. -->
                                                                    <Grid Grid.Row="0" Grid.Column="1" Margin="8,0">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowIndividualRangeAdjustment}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="78"/>
                                                                            <ColumnDefinition Width="34"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider Grid.Column="0" Minimum="{Binding ExtentSliderMin}" Maximum="{Binding ExtentSliderMax}"
                                                                                Value="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="Independent minimum URDF extent for this physical flap."/>
                                                                        <TextBox Grid.Column="1" Text="{Binding MinExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                                                 Margin="5,0,3,0" Padding="4,2" KeyDown="ExtentTextBox_KeyDown"
                                                                                 ToolTip="Type this flap's independent minimum extent. Press Enter, Tab, or click elsewhere to apply it."/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource SecondaryText}"/>
                                                                    </Grid>

                                                                    <!-- FlapsOpen only: each physical flap owns its own Max extent. -->
                                                                    <Grid Grid.Row="0" Grid.Column="2" Margin="8,0">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowIndividualRangeAdjustment}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="78"/>
                                                                            <ColumnDefinition Width="34"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider Grid.Column="0" Minimum="{Binding ExtentSliderMin}" Maximum="{Binding ExtentSliderMax}"
                                                                                Value="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="Independent maximum URDF extent for this physical flap."/>
                                                                        <TextBox Grid.Column="1" Text="{Binding MaxExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                                                 Margin="5,0,3,0" Padding="4,2" KeyDown="ExtentTextBox_KeyDown"
                                                                                 ToolTip="Type this flap's independent maximum extent. Press Enter, Tab, or click elsewhere to apply it."/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource SecondaryText}"/>
                                                                    </Grid>

                                                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                                                        <CheckBox IsChecked="{Binding Reverse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Content="Reversed" Foreground="{DynamicResource PrimaryText}"
                                                                                  VerticalAlignment="Center"
                                                                                  ToolTip="Independent URDF direction for this child. Starts from Servo Configuration; changing it creates a URDF-only override."/>
                                                                        <TextBlock Text="{Binding ReverseText}" FontSize="10" Margin="8,0,0,0"
                                                                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                                                    </StackPanel>

                                                                    <!-- Every physical URDF child has an independent Zero Point. FlapsOpen bounds it by that child's independent Min/Max; other gangs use the shared Min/Max. -->
                                                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4,8,0">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowZeroAdjustment}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="58"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="76"/>
                                                                            <ColumnDefinition Width="34"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Zero:" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource PrimaryText}"/>
                                                                        <Slider Grid.Column="1" Minimum="{Binding ZeroSliderMin}" Maximum="{Binding ZeroSliderMax}"
                                                                                Value="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="Independent physical URDF extent for this servo at logical input 0."/>
                                                                        <TextBox Grid.Column="2" Text="{Binding ZeroExtent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                                                 Margin="5,0,3,0" Padding="4,2" KeyDown="ExtentTextBox_KeyDown"
                                                                                 ToolTip="Type this servo's independent zero point. Press Enter, Tab, or click elsewhere to apply it."/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding Unit}" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource SecondaryText}"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
