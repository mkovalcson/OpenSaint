<Window x:Class="ServoAnimator.ControlsHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controls &amp; Hotkeys" Width="680" Height="610" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" Content="Close" Width="90" HorizontalAlignment="Right"
                Margin="0,12,0,0" IsDefault="True" Click="Close_Click"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Controls &amp; Hotkeys" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Movie" Foreground="#E2BE7E" FontSize="15" FontWeight="SemiBold" Margin="0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Up Arrow" Foreground="{DynamicResource WarningText}"/><TextBlock Grid.Column="1" Text="Play / pause / resume movie sequence" Foreground="#D9DDE4"/>
                    <TextBlock Grid.Column="0" Margin="0,24,0,0" Text="Right Arrow" Foreground="{DynamicResource WarningText}"/><TextBlock Grid.Column="1" Margin="0,24,0,0" Text="Load and play next sequence" Foreground="#D9DDE4"/>
                    <TextBlock Grid.Column="0" Margin="0,48,0,0" Text="Left Arrow" Foreground="{DynamicResource WarningText}"/><TextBlock Grid.Column="1" Margin="0,48,0,0" Text="Restart current sequence; at boundary move to previous" Foreground="#D9DDE4"/>
                    <TextBlock Grid.Column="0" Margin="0,72,0,0" Text="Down Arrow" Foreground="{DynamicResource WarningText}"/><TextBlock Grid.Column="1" Margin="0,72,0,0" Text="Move to beginning of movie" Foreground="#D9DDE4"/>
                </Grid>
                <TextBlock Text="Timeline mouse controls" Foreground="#8FB9E3" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBlock Foreground="#D9DDE4" TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run Text="Left click" FontWeight="SemiBold"/> positions the cursor.  <Run Text="Mouse wheel" FontWeight="SemiBold"/> zooms.  <Run Text="Middle drag" FontWeight="SemiBold"/> pans.  <Run Text="Right click" FontWeight="SemiBold"/> opens context actions.  Drag a gold downward triangle marker to move its complete command group. Nearby markers stagger vertically when they overlap.
                </TextBlock>
                <TextBlock Text="Spline editor" Foreground="#8FB9E3" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBlock Foreground="#D9DDE4" TextWrapping="Wrap" Margin="0,0,0,10">
                    Left-drag a control point vertically to change value. Right-drag a point horizontally to change time. Ctrl+left-click a spline line to add a point. Select a point and press Delete to remove it. Hovering shows the exact servo, time and value.
                </TextBlock>
                <TextBlock Text="Movie blocks" Foreground="#E2BE7E" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBlock Foreground="#D9DDE4" TextWrapping="Wrap" Margin="0,0,0,10">
                    Drag a block using the left mouse button to reorder it; the gold insertion line shows the destination. Right-click a block to remove it or right-click a sequence boundary to insert. The movie wheel zoom and middle-drag pan work independently of the sequence timeline.
                </TextBlock>
                <TextBlock Text="Editing" Foreground="#A8D2A8" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBlock Foreground="#D9DDE4" TextWrapping="Wrap">
                    Ctrl+Z = Undo. Ctrl+Y = Redo. In Commands at Cursor, double-click edits the command group and Delete removes the selected command. An asterisk next to a Sequence or Movie filename indicates unsaved changes.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
