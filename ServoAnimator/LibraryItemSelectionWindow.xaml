<Window x:Class="ServoAnimator.LibraryItemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation Library"
        Width="1180" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ModeText" Grid.Column="0" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Search:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="2" Height="34" VerticalAlignment="Center"
                     ToolTip="Filter by category, folder, filename, description, or audio filename"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}"
                  RowBackground="{DynamicResource PanelBackground}" AlternatingRowBackground="{DynamicResource ElevatedPanelBackground}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BeginningEdit="ItemsGrid_BeginningEdit"
                  SelectionChanged="ItemsGrid_SelectionChanged"
                  MouseDoubleClick="ItemsGrid_MouseDoubleClick">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#15181D"/>
                    <Setter Property="Foreground" Value="#E6E8EC"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="145" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="FolderColumn" Header="Folder" Binding="{Binding Folder}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="3*" MinWidth="180" IsReadOnly="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="6,5"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="AcceptsReturn" Value="True"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MinHeight" Value="34"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn x:Name="PoseImageColumn" Header="Image" Width="190" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="4" Background="{DynamicResource InputBackground}" Margin="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding ImageSource}" Height="140" Stretch="Uniform"/>
                                    <TextBlock Text="(No image attached)" Foreground="{DynamicResource SecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="AudioFilesColumn" Header="Audio files" Binding="{Binding AudioFiles}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel x:Name="CategoryPanel" Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CategoryPicker" Width="190" Margin="0,0,8,0"/>
            <Button x:Name="SaveCategoryButton" Content="Set Category" Padding="10,4" Margin="0,0,8,0" Click="SaveCategory_Click"/>
            <Button Content="Manage Categories…" Padding="10,4" Click="ManageCategories_Click"/>
        </WrapPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#FF8D8D"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="Delete Selected"
                    Width="120" Padding="0,4" Margin="0,0,8,0"
                    Click="DeleteSelected_Click"/>
            <Button x:Name="SelectButton" Content="Use Selected Sequence"
                    Width="150" Padding="0,4" Margin="0,0,8,0"
                    IsDefault="True" Click="Select_Click"/>
            <Button Content="Close" Width="90" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
