<Window x:Class="ServoAnimator.LibraryItemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation Library"
        Width="1180" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ModeText" Grid.Column="0" Foreground="#C8CCD4" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Search:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="2" Height="34" VerticalAlignment="Center"
                     ToolTip="Filter by folder, filename, description, or audio filename"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}"
                  RowBackground="{DynamicResource PanelBackground}" AlternatingRowBackground="#282C33"
                  BorderBrush="{DynamicResource DividerBrush}"
                  SelectionChanged="ItemsGrid_SelectionChanged"
                  MouseDoubleClick="ItemsGrid_MouseDoubleClick">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#15181D"/>
                    <Setter Property="Foreground" Value="#E6E8EC"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="145"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="180"/>
                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="220"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                <DataGridTextColumn x:Name="AudioFilesColumn" Header="Audio files" Binding="{Binding AudioFiles}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid x:Name="DescriptionGrid" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ImageColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="DescriptionLabel" Grid.Row="0" Grid.Column="0"
                       Text="Selected Library Sequence description:" Foreground="{DynamicResource HeaderText}"
                       FontWeight="Bold" Margin="0,0,8,4"/>
            <TextBox x:Name="DescriptionEditor" Grid.Row="1" Grid.Column="0" Height="190" Margin="0,0,8,0"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}"
                     BorderBrush="{DynamicResource DividerBrush}" Padding="8"/>

            <StackPanel x:Name="ImagePanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Attached image:" Foreground="{DynamicResource HeaderText}"
                           FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Height="190" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Background="#101216" Padding="4">
                    <Grid>
                        <Image x:Name="CommandImage" Stretch="Uniform"/>
                        <TextBlock x:Name="NoImageText" Text="(No image attached)"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Grid.ColumnSpan="2" Foreground="#FF8D8D"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="Delete Selected"
                    Width="120" Padding="0,4" Margin="0,0,8,0"
                    Click="DeleteSelected_Click"/>
            <Button x:Name="ImageButton" Content="Add / Change Image…"
                    Width="145" Padding="0,4" Margin="0,0,8,0"
                    Click="AddChangeImage_Click"/>
            <Button x:Name="SaveDescriptionButton" Content="Save Description"
                    Width="130" Padding="0,4" Margin="0,0,8,0"
                    Click="SaveDescription_Click"/>
            <Button x:Name="SelectButton" Content="Use Selected Sequence"
                    Width="150" Padding="0,4" Margin="0,0,8,0"
                    IsDefault="True" Click="Select_Click"/>
            <Button Content="Close" Width="90" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
