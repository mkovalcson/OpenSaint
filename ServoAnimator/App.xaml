<Application x:Class="ServoAnimator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ServoAnimator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ==============================================================
             Theme palette. ThemeManager mutates these shared brush objects
             at runtime, so existing windows update immediately.
             ============================================================== -->
        <SolidColorBrush x:Key="AppBackground" Color="#191E27"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#222A35"/>
        <SolidColorBrush x:Key="ElevatedPanelBackground" Color="#293341"/>
        <SolidColorBrush x:Key="MenuBackground" Color="#222A35"/>
        <SolidColorBrush x:Key="InputBackground" Color="#171D26"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#2B3645"/>
        <SolidColorBrush x:Key="ControlHover" Color="#37475D"/>
        <SolidColorBrush x:Key="ControlPressed" Color="#425975"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#46576D"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#344152"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#EAF0F7"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#B0BDCF"/>
        <SolidColorBrush x:Key="HeaderText" Color="#A1B7D3"/>
        <SolidColorBrush x:Key="SequenceAccent" Color="#84B5F0"/>
        <SolidColorBrush x:Key="SequenceAccentSurface" Color="#35577F"/>
        <SolidColorBrush x:Key="SequencePanelBackground" Color="#222D3B"/>
        <SolidColorBrush x:Key="SequenceBadgeBackground" Color="#35577F"/>
        <SolidColorBrush x:Key="MovieAccent" Color="#DEB46F"/>
        <SolidColorBrush x:Key="MovieAccentSurface" Color="#574932"/>
        <SolidColorBrush x:Key="MoviePanelBackground" Color="#252A32"/>
        <SolidColorBrush x:Key="MovieBadgeBackground" Color="#655030"/>
        <SolidColorBrush x:Key="SelectionBackground" Color="#35577F"/>
        <SolidColorBrush x:Key="FocusBorder" Color="#A1C8FA"/>
        <SolidColorBrush x:Key="StatusBackground" Color="#151B24"/>
        <SolidColorBrush x:Key="InspectorBackground" Color="#1D2632"/>
        <SolidColorBrush x:Key="WarningText" Color="#FFD18A"/>
        <SolidColorBrush x:Key="LiveDriveText" Color="#D8FFE5"/>

        <!-- Geometry/spacing tokens. These are deliberately shared by every
             dialog so the application reads as one finished UI rather than
             a collection of stock WPF controls. -->
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
        <Thickness x:Key="ControlPadding">10,4</Thickness>
        <Thickness x:Key="CompactControlPadding">8,3</Thickness>
        <Thickness x:Key="InputPadding">7,3</Thickness>


        <local:StudioTransportConverter x:Key="StudioTransportConverter"/>
        <Style x:Key="StudioFocusVisual" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate>
                <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource FocusBorder}"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="DialogSubtitle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <LinearGradientBrush x:Key="ViewportBackground" StartPoint="0,0" EndPoint="0.7,1">
            <GradientStop Color="#CCD8E5" Offset="0"/>
            <GradientStop Color="#A0B3C8" Offset="0.55"/>
            <GradientStop Color="#7F96AF" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <!-- Rounded button template. Stock WPF Button ignores CornerRadius;
             this template is what makes the radius real rather than cosmetic. -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
                            </Trigger>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SequenceAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsDefault" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SequenceAccentSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SequenceAccent}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SequenceAccentSurface}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SequenceAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The stock ComboBox template also has square chrome. This compact
             replacement keeps native selection/popup behavior while using the
             same six-pixel radius as buttons and text fields. -->
        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="11"
                                               Foreground="{DynamicResource SecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Style="{StaticResource ComboToggleStyle}"
                                                  Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,3,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320"
                                        Background="{DynamicResource ElevatedPanelBackground}"
                                        BorderBrush="{DynamicResource ControlBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallCornerRadius}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False" Padding="0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent"
                                CornerRadius="{StaticResource SmallCornerRadius}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explicit Separator elements are group boundaries. MenuItem itself
             has no bottom border, so individual commands are separated only
             by whitespace; the visible line appears only where the XAML has
             an intentional Separator. -->
        <Style x:Key="AppSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Margin" Value="7,5"/>
            <Setter Property="Height" Value="1"/>
        </Style>
        <Style TargetType="Separator" BasedOn="{StaticResource AppSeparatorStyle}"/>

        <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#20242A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource StatusBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SequenceAccentSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SequenceAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StudioLiveDriveToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="HardwareChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HardwareChrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="HardwareChrome" Property="Background" Value="#245C43"/>
                        <Setter TargetName="HardwareChrome" Property="BorderBrush" Value="#83D2A4"/>
                        <Setter Property="Foreground" Value="{DynamicResource LiveDriveText}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HardwareChrome" Property="Opacity" Value="0.48"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StudioTransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{Binding Converter={StaticResource StudioTransportConverter}}"/>
                    <TextBlock Text="{Binding Converter={StaticResource StudioTransportConverter}, ConverterParameter=Label}"
                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <!-- URDF-only straight sliders: rounded rail and square blue handle,
             without tick labels. Keep native Track/Thumb input behavior. -->
        <Style x:Key="UrdfSliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="UrdfSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Handle" Background="#60A5FA" BorderBrush="White"
                            BorderThickness="2" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect Color="#6687B0" BlurRadius="6" ShadowDepth="1" Opacity="0.38"/>
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="#79B5FF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="#3B82F6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="UrdfPoseSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderSurface" Background="Transparent">
                        <Border x:Name="Rail" Height="8" Margin="9,0" VerticalAlignment="Center"
                                Background="#DEE5EF" CornerRadius="4" IsHitTestVisible="False"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource UrdfSliderTrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource UrdfSliderThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource UrdfSliderTrackButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Rail" Property="Height" Value="Auto"/>
                            <Setter TargetName="Rail" Property="Width" Value="8"/>
                            <Setter TargetName="Rail" Property="Margin" Value="0,9"/>
                            <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Rail" Property="Background" Value="#C3D8F3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SliderSurface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="StudioPlayButton" TargetType="Button" BasedOn="{StaticResource StudioTransportButton}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Background" Value="{DynamicResource SequenceAccentSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SequenceAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NumericInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="RowBackground" Value="{DynamicResource InputBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ElevatedPanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

    </Application.Resources>
</Application>
