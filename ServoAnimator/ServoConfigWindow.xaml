<Window x:Class="ServoAnimator.ServoConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Servo Configuration"
        Width="1380" Height="720"
        MinWidth="920" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <!-- ==================================================================
         Editable configuration for every physical servo channel, grouped
         under its ganged ServoName (the group header). Per control:
           Maestro Port | Name | Normal/Reversed (relative to the gang) |
           Default / Min / Max PWM (clamped 500..2400) |
           Speeds "d,s,f,c" | Accels "d,s,f,c" |
           verify SLIDER (Min..Max PWM) that drives the servo live via
           MoveRobotControlNow().
         File > Load / Save / Save As persist the whole set to JSON.
         ================================================================== -->
    <DockPanel Margin="10">

        <!-- File/configuration bar.  File operations live under the File
             menu; the active configuration filename and Left Tic serial
             remain visible beside it. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" VerticalAlignment="Center"
                  Background="Transparent" Foreground="{DynamicResource PrimaryText}">
                <MenuItem Header="_File" Foreground="#F2F4F8">
                    <MenuItem Header="_Load…" Click="Load_Click"/>
                    <MenuItem Header="_Save" Click="Save_Click"/>
                    <MenuItem Header="Save _As…" Click="SaveAs_Click"/>
                    <Separator/>
                    <MenuItem Header="_Close" Click="Close_Click"/>
                </MenuItem>
            </Menu>

            <TextBlock Grid.Column="1" x:Name="ConfigPathText"
                       Foreground="{DynamicResource HeaderText}"
                       VerticalAlignment="Center" Margin="12,0,18,0"
                       Text="(unsaved configuration)"/>

            <TextBlock Grid.Column="2" Text="Left Tic SN:" Foreground="#C8CCD4"
                       VerticalAlignment="Center" Margin="0,0,4,0"
                       ToolTip="Serial number of the LEFT Tic T249 eye-pop controller (empty = first found is left)"/>
            <TextBox Grid.Column="3" x:Name="LeftTicBox" Width="110"
                     VerticalAlignment="Center" LostFocus="LeftTic_LostFocus"/>
        </Grid>

        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="97"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Port"         Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="RobotControl" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Text="Direction"   Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Text="Default"     Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="4" Text="Min"         Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="5" Text="Max"         Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="6" Text="Speeds d,s,f,c" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="7" Text="Accels d,s,f,c" Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
            <TextBlock Grid.Column="8" Text="Drive (PWM verify)" Foreground="{DynamicResource HeaderText}" FontWeight="Bold" Margin="6,0"/>
            <TextBlock Grid.Column="9" Text="PWM"         Foreground="{DynamicResource HeaderText}" FontWeight="Bold"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2,0,8">
                            <!-- Group header: the ganged ServoName (or plain
                                 title). Real gangs get a slider spanning the
                                 gang's timeline range that drives every
                                 servo in it, like the display grid. -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="235"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding GangName}"
                                           Foreground="{DynamicResource WarningText}" FontWeight="Bold"
                                           FontSize="14" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" VerticalAlignment="Center"
                                        Minimum="{Binding GangMin}"
                                        Maximum="{Binding GangMax}"
                                        Value="{Binding GangValue, Mode=TwoWay}">
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGangSlider}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                                <TextBlock Grid.Column="2" Text="{Binding GangValue, StringFormat=F0}"
                                           Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGangSlider}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Ganged speed/acceleration profiles. Editing
                                     these copies d,s,f,c values to every physical
                                     child in the gang. NeckTiltRight/NeckNodUp
                                     share the same physical settings; only their
                                     Direction columns remain independent. -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGangSpeedSettings}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Gang Speeds d,s,f,c" Foreground="{DynamicResource HeaderText}"
                                               VerticalAlignment="Center" Margin="8,0,5,0"/>
                                    <TextBox Width="105" Margin="0,0,12,0"
                                             ToolTip="Changing this copies all four speed profiles to every child servo in this gang"
                                             Text="{Binding GangSpeedsText, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="Gang Accels d,s,f,c" Foreground="{DynamicResource HeaderText}"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Width="95"
                                             ToolTip="Changing this copies all four acceleration profiles to every child servo in this gang"
                                             Text="{Binding GangAccelsText, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,3"/>

                            <ItemsControl ItemsSource="{Binding Controls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="185"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="97"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Physical Maestro channel.  This exists only on
                                                 individual servo rows, never on gang headers. -->
                                            <TextBox Grid.Column="0" Margin="0,0,4,0"
                                                     HorizontalContentAlignment="Center"
                                                     MaxLength="2"
                                                     PreviewTextInput="Port_PreviewTextInput"
                                                     DataObject.Pasting="Port_Pasting"
                                                     ToolTip="Pololu Maestro channel (0-23) used by this physical servo"
                                                     Text="{Binding MaestroPort, UpdateSourceTrigger=LostFocus}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPortConflict}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF3030"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPortConflict}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF3030"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Normal / Reversed relative to the gang -->
                                            <ComboBox Grid.Column="2" Margin="0,0,6,0"
                                                      ItemsSource="{Binding DirectionOptions}"
                                                      SelectedItem="{Binding Direction}"/>

                                            <TextBox Grid.Column="3" Margin="0,0,4,0"
                                                     Text="{Binding DefaultPwm, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Column="4" Margin="0,0,4,0"
                                                     Text="{Binding MinPwm, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Column="5" Margin="0,0,4,0"
                                                     Text="{Binding MaxPwm, UpdateSourceTrigger=LostFocus}"/>

                                            <TextBox Grid.Column="6" Margin="0,0,4,0"
                                                     Text="{Binding SpeedsText, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Column="7" Margin="0,0,4,0"
                                                     Text="{Binding AccelsText, UpdateSourceTrigger=LostFocus}"/>

                                            <!-- Verify slider: drives the servo -->
                                            <Slider Grid.Column="8" Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Minimum="{Binding MinPwm}"
                                                    Maximum="{Binding MaxPwm}"
                                                    Value="{Binding SliderPwm, Mode=TwoWay}"/>

                                            <TextBlock Grid.Column="9" Text="{Binding SliderPwm, StringFormat=F0}"
                                                       Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
