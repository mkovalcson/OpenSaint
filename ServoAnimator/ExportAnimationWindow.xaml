<Window x:Class="ServoAnimator.ExportAnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Animation JSON"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">
    <!-- Export options + destination in one place (moved here from the
         spline area): animate mode, spline sample rate, Scale ±1, and the
         output file. All three options persist with the sequence. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Animate mode:"
                   Foreground="#C8CCD4" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="ModeCombo" Grid.Row="0" Grid.Column="1"
                  Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Spline sample rate:"
                   Foreground="#C8CCD4" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="HzCombo" Grid.Row="1" Grid.Column="1"
                  Width="110" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <CheckBox x:Name="ScaleCheck" Grid.Row="2" Grid.Column="1"
                  Content="Scale ±1  (export numeric values as -1.000..1.000 / 0..1.000)"
                  Foreground="#C8CCD4" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Export to file:"
                   Foreground="#C8CCD4" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="PathBox" Grid.Row="3" Grid.Column="1" Margin="0,0,6,0"
                 VerticalAlignment="Center"/>
        <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Padding="10,3"
                Click="Browse_Click"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Export" Width="86" Padding="0,4" IsDefault="True"
                    Margin="0,0,8,0" Click="Export_Click"/>
            <Button Content="Cancel" Width="86" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
